---
interface Props {
  id: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  secondaryBg?: boolean;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  secondaryBg = false,
  class: className = '',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'relative py-20 sm:py-24 md:py-28 transition-colors duration-300',
    secondaryBg
      ? 'bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200/60 dark:border-slate-800/60'
      : 'bg-transparent',
    className,
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    {
      (eyebrow || title || subtitle) && (
        <div class="max-w-3xl mb-14 md:mb-16">
          {eyebrow && (
            <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-emerald-700 dark:text-emerald-400 mb-3">
              <span class="w-2 h-0.5 bg-emerald-500 rounded-full" />
              <span>{eyebrow}</span>
            </div>
          )}
          {title && (
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-950 dark:text-white leading-tight mb-4">
              {title}
            </h2>
          )}
          {subtitle && (
            <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
              {subtitle}
            </p>
          )}
        </div>
      )
    }

    <slot />
  </div>
</section>
