---
import SectionNavigationTemplate from '../SectionNavigationTemplate.astro';
import sectionsData from '../../../data/sections.json';

const navigation = sectionsData.find((section) => section.id === 'week-02')?.navigation || [];
---

<SectionNavigationTemplate sectionId="week-02" navigation={navigation} />

<div id="week-02-overview" class="space-y-6 scroll-mt-28">
  <section class="p-8 rounded-2xl bg-slate-50/70 dark:bg-slate-800/40 border border-dashed border-slate-300 dark:border-slate-700">
    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Prototyping Sprint</span>
    <h3 class="text-2xl font-bold text-slate-950 dark:text-white mt-2">Week 02 Content</h3>
    <p class="text-slate-600 dark:text-slate-400 mt-3">
      Add this week's dedicated content directly in this component.
    </p>
  </section>
</div>
