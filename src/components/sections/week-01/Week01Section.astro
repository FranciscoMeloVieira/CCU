---
import week01Data from '../../../data/week01/week01.json';
import InterviewGroup from './InterviewGroup.astro';
import SectionNavigationTemplate from '../SectionNavigationTemplate.astro';
import sectionsData from '../../../data/sections.json';

interface Interview {
  id: string;
  category: 'user' | 'stakeholder';
  title: string;
  description?: string;
  file: string;
}

const interviews = week01Data.interviews as Interview[];

const userInterviews = interviews.filter((interview) => interview.category === 'user');
const stakeholderInterviews = interviews.filter((interview) => interview.category === 'stakeholder');
const navigation = sectionsData.find((section) => section.id === 'week-01')?.navigation || [];
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const getPdfUrl = (fileName: string) => {
  return `${baseUrl}interviews/${fileName}`;
};
---

<SectionNavigationTemplate sectionId="week-01" navigation={navigation} />

<div id="week-01-overview" class="space-y-10 scroll-mt-28">
  <section id="week-01-research">
    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Discovery Sprint</span>
    <h3 class="text-2xl font-bold text-slate-950 dark:text-white mt-2">Interview Research</h3>
    <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed mt-5">
      Review the interview answers collected from users and stakeholders during Week 01.
    </p>
  </section>

  <div id="week-01-user-interviews">
    <InterviewGroup
      title="User Interviews"
      description="Interviews with people who experience the mobility context directly."
      items={userInterviews}
      getPdfUrl={getPdfUrl}
    />
  </div>

  <div id="week-01-stakeholder-interviews">
    <InterviewGroup
      title="Stakeholder Interviews"
      description="Interviews with stakeholders involved in or affected by the project context."
      items={stakeholderInterviews}
      getPdfUrl={getPdfUrl}
    />
  </div>
</div>
