---
import projectData from '../../../data/project.json';
import sidDimensionsData from '../../../data/sid-dimensions.json';
import teamData from '../../../data/team.json';
import SelectionMatrix from './SelectionMatrix.astro';
import SIDCard from './SIDCard.astro';
import TeamCard from './TeamCard.astro';

const activeDimensions = sidDimensionsData.filter((dimension) => dimension.enabled);
---

<div class="space-y-16">
  <section id="background-context" class="scroll-mt-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-7 space-y-4 text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg">
        {projectData.background.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="lg:col-span-5 space-y-4">
        {projectData.background.highlights.map((highlight) => (
          <div class="p-5 bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl">
            <div class="text-2xl font-extrabold text-emerald-700 dark:text-emerald-400">{highlight.metric}</div>
            <div class="text-xs uppercase font-bold tracking-wider text-slate-900 dark:text-white">{highlight.label}</div>
            <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">{highlight.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="background-matrix" class="scroll-mt-28"><SelectionMatrix /></section>

  <section id="background-objectives" class="scroll-mt-28 pt-10 border-t border-slate-200 dark:border-slate-800">
    <h3 class="text-2xl font-bold text-slate-950 dark:text-white">{projectData.objectives.title}</h3>
    <p class="text-slate-600 dark:text-slate-400 mt-2 mb-6">{projectData.objectives.subtitle}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projectData.objectives.items.map((item) => (
        <article class="p-6 bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl">
          <span class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400">STEP {item.number}</span>
          <h4 class="text-lg font-bold text-slate-900 dark:text-white mt-3">{item.title}</h4>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="background-framework" class="scroll-mt-28 pt-10 border-t border-slate-200 dark:border-slate-800">
    <h3 class="text-2xl font-bold text-slate-950 dark:text-white">Sustainable Interaction Design (SID) Framework</h3>
    <p class="text-slate-600 dark:text-slate-400 mt-2 mb-6">Grounding computational interactions in ecological longevity, visceral clarity, and collective commons.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {activeDimensions.map((dimension, index) => <SIDCard dimension={dimension} index={index} />)}
    </div>
  </section>

  <section id="background-team" class="scroll-mt-28 pt-10 border-t border-slate-200 dark:border-slate-800">
    <h3 class="text-2xl font-bold text-slate-950 dark:text-white">Project Team</h3>
    <p class="text-slate-600 dark:text-slate-400 mt-2 mb-6">Collaborative design, contextual field research, and technical prototyping.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {teamData.map((member) => <TeamCard member={member} />)}
    </div>
  </section>
</div>
