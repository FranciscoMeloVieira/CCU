---
export interface SIDDimension {
  id: string;
  title: string;
  icon?: string;
  enabled: boolean;
  shortDescription: string;
  detailedDescription: string;
  keyPrinciples: string[];
  practicalExamples: string[];
}

interface Props {
  dimension: SIDDimension;
  index: number;
}

const { dimension, index } = Astro.props;
---

<article
  id={dimension.id}
  class="sid-card group flex flex-col bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-300 dark:hover:border-emerald-700/60 transition-all duration-300 overflow-hidden scroll-mt-28"
  data-card-id={dimension.id}
>
  <!-- Card Header & Toggle Trigger -->
  <button
    type="button"
    class="sid-toggle-btn w-full p-6 sm:p-7 text-left flex flex-col justify-between flex-grow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-2xl"
    aria-expanded="false"
    aria-controls={`sid-content-${dimension.id}`}
  >
    <div>
      <div class="flex items-center justify-between gap-4 mb-4">
        <!-- Icon Container with Emerald Accent -->
        <div
          class="w-12 h-12 rounded-xl flex items-center justify-center bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/70 dark:border-emerald-800/60 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-900/40 transition-colors"
        >
          {dimension.icon === 'repeat' && (
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          )}
          {dimension.icon === 'eye' && (
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          )}
          {dimension.icon === 'users' && (
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          )}
          {dimension.icon === 'shield-check' && (
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          )}
          {!['repeat', 'eye', 'users', 'shield-check'].includes(dimension.icon ?? '') && (
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          )}
        </div>

        <!-- Dimension Index Badge -->
        <span class="text-xs font-mono font-semibold text-slate-400 dark:text-slate-500 tracking-wider">
          DIMENSION 0{index + 1}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2.5 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
        {dimension.title}
      </h3>

      <!-- Short Description -->
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        {dimension.shortDescription}
      </p>
    </div>

    <!-- Toggle Action Callout -->
    <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800/80 text-xs font-semibold text-emerald-700 dark:text-emerald-400 mt-2">
      <span class="sid-toggle-label">Read Full Dimension</span>
      <div
        class="sid-chevron-circle w-7 h-7 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 group-hover:bg-emerald-600 group-hover:text-white dark:group-hover:bg-emerald-500 transition-all duration-200"
      >
        <svg
          class="sid-chevron-icon w-4 h-4 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </button>

  <!-- Collapsible Details Area (CSS Grid Expansion Animation) -->
  <div
    id={`sid-content-${dimension.id}`}
    class="sid-expandable-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
  >
    <div class="overflow-hidden">
      <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-2 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
        <!-- Detailed Description -->
        <div class="mb-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
            Theoretical Context
          </h4>
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            {dimension.detailedDescription}
          </p>
        </div>

        <!-- Key Principles -->
        {dimension.keyPrinciples && dimension.keyPrinciples.length > 0 && (
          <div class="mb-5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
              Key Principles
            </h4>
            <ul class="space-y-2 list-none m-0 p-0">
              {dimension.keyPrinciples.map((principle) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0" />
                  <span>{principle}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Practical Examples -->
        {dimension.practicalExamples && dimension.practicalExamples.length > 0 && (
          <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/60">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
              Applied Examples in Project
            </h4>
            <div class="space-y-2">
              {dimension.practicalExamples.map((example) => (
                <div class="p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-400 flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{example}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  function setupSIDCards() {
    const cards = document.querySelectorAll('.sid-card');

    function toggleCard(card: Element, shouldExpand?: boolean) {
      const button = card.querySelector('.sid-toggle-btn');
      const content = card.querySelector('.sid-expandable-content');
      const chevron = card.querySelector('.sid-chevron-icon');
      const label = card.querySelector('.sid-toggle-label');
      const isExpanded = button?.getAttribute('aria-expanded') === 'true';
      const targetState = shouldExpand !== undefined ? shouldExpand : !isExpanded;

      if (targetState) {
        button?.setAttribute('aria-expanded', 'true');
        content?.classList.remove('grid-rows-[0fr]');
        content?.classList.add('grid-rows-[1fr]');
        chevron?.classList.add('rotate-180');
        if (label) label.textContent = 'Collapse Dimension';
      } else {
        button?.setAttribute('aria-expanded', 'false');
        content?.classList.remove('grid-rows-[1fr]');
        content?.classList.add('grid-rows-[0fr]');
        chevron?.classList.remove('rotate-180');
        if (label) label.textContent = 'Read Full Dimension';
      }
    }

    cards.forEach((card) => {
      const button = card.querySelector('.sid-toggle-btn');
      button?.addEventListener('click', () => {
        toggleCard(card);
      });
    });

    // Auto-expand card if navigated via anchor URL (e.g. #practices-routines)
    function handleAnchor() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;
      const targetCard = document.getElementById(hash);
      if (targetCard && targetCard.classList.contains('sid-card')) {
        toggleCard(targetCard, true);
        targetCard.classList.add('ring-2', 'ring-emerald-500');
        setTimeout(() => {
          targetCard.classList.remove('ring-2', 'ring-emerald-500');
        }, 2200);
      }
    }

    window.addEventListener('hashchange', handleAnchor);
    handleAnchor();
  }

  document.addEventListener('DOMContentLoaded', setupSIDCards);
</script>
