---
---

<nav
  id="desktop-floating-nav"
  aria-label="Context-aware section navigation"
  class="fixed right-6 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-center gap-2 p-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-xl shadow-slate-300/30 dark:shadow-slate-950/60"
>
  <button
    id="desktop-return-overview-btn"
    type="button"
    class="hidden flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl mb-1"
  >
    <span aria-hidden="true">←</span>
    <span>Overview</span>
  </button>

  <ul id="desktop-overview-navigation" class="nav-context-group flex flex-col gap-1.5 m-0 p-0 list-none" data-nav-group="overview">
    <li>
      <a href="#hero" data-section="hero" class="nav-link group relative flex items-center gap-3 px-3 py-2 text-xs font-medium text-slate-600 dark:text-slate-400 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all">
        <span class="nav-icon-wrapper w-5 text-center" aria-hidden="true">⌂</span>
        <span>Overview</span>
        <span class="active-indicator absolute left-0 top-1/2 -translate-y-1/2 w-1 h-4 bg-emerald-500 rounded-r opacity-0" />
      </a>
    </li>
    <li>
      <a href="#project-hub" data-section="project-hub" class="nav-link group relative flex items-center gap-3 px-3 py-2 text-xs font-medium text-slate-600 dark:text-slate-400 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all">
        <span class="nav-icon-wrapper w-5 text-center" aria-hidden="true">▦</span>
        <span>Project Hub</span>
        <span class="active-indicator absolute left-0 top-1/2 -translate-y-1/2 w-1 h-4 bg-emerald-500 rounded-r opacity-0" />
      </a>
    </li>
  </ul>
  <div id="desktop-section-navigation-host"></div>
  <div class="w-full mt-2 pt-2 border-t border-slate-100 dark:border-slate-800">
    <button
      id="theme-toggle-desktop"
      type="button"
      class="w-full px-3 py-2 text-[11px] font-medium text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
      aria-label="Switch color theme"
    >
      <svg class="w-4 h-4 dark:hidden mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l.707-.707M6.343 17.657l.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg class="hidden dark:block w-4 h-4 mx-auto text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
    </button>
  </div>
</nav>

<header class="lg:hidden fixed top-4 right-4 z-50">
  <button id="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Open mobile navigation menu" class="flex items-center justify-center w-11 h-11 bg-white/90 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 rounded-xl shadow-lg text-slate-700 dark:text-slate-200">
    <span id="hamburger-icon" aria-hidden="true">☰</span>
    <span id="close-icon" class="hidden" aria-hidden="true">×</span>
  </button>
</header>

<div id="mobile-nav-backdrop" class="fixed inset-0 z-40 bg-slate-950/40 opacity-0 pointer-events-none transition-opacity lg:hidden" aria-hidden="true"></div>

<div id="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Site navigation" class="fixed top-0 right-0 bottom-0 z-50 w-72 max-w-[85vw] bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl p-6 flex flex-col justify-between translate-x-full transition-transform lg:hidden">
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-slate-100 dark:border-slate-800">
      <span id="mobile-nav-title" class="text-sm font-semibold tracking-wider uppercase text-slate-900 dark:text-white">Navigation</span>
      <button id="mobile-nav-close" type="button" aria-label="Close navigation menu" class="p-2 text-slate-500 dark:text-slate-400">×</button>
    </div>
    <div id="mobile-return-overview-box" class="hidden mt-4 pb-4 border-b border-slate-100 dark:border-slate-800">
      <button id="mobile-return-overview-btn" type="button" class="w-full px-3.5 py-2 rounded-xl text-xs font-semibold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60">← Return to Overview</button>
    </div>
    <ul id="mobile-overview-navigation" class="mobile-nav-context-group flex flex-col gap-2 mt-4 m-0 p-0 list-none" data-mobile-group="overview">
      <li><a href="#hero" data-section="hero" class="mobile-nav-link flex justify-between px-4 py-3 text-sm text-slate-700 dark:text-slate-300 rounded-xl">Overview <span>→</span></a></li>
      <li><a href="#project-hub" data-section="project-hub" class="mobile-nav-link flex justify-between px-4 py-3 text-sm text-slate-700 dark:text-slate-300 rounded-xl">Project Hub <span>→</span></a></li>
    </ul>
    <div id="mobile-section-navigation-host"></div>
  </div>
  <button id="theme-toggle-mobile" type="button" class="px-3 py-2 text-xs text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg" aria-label="Switch color theme">
    <svg class="w-4 h-4 dark:hidden mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l.707-.707M6.343 17.657l.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg class="hidden dark:block w-4 h-4 mx-auto text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
    </svg>
  </button>
</div>

<script>
  function setupNavigation() {
    const desktopOverview = document.getElementById('desktop-overview-navigation');
    const mobileOverview = document.getElementById('mobile-overview-navigation');
    const desktopHost = document.getElementById('desktop-section-navigation-host');
    const mobileHost = document.getElementById('mobile-section-navigation-host');
    const desktopReturn = document.getElementById('desktop-return-overview-btn');
    const mobileReturnBox = document.getElementById('mobile-return-overview-box');
    const mobileReturn = document.getElementById('mobile-return-overview-btn');
    const mobileTitle = document.getElementById('mobile-nav-title');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const toggle = document.getElementById('mobile-nav-toggle');
    const close = document.getElementById('mobile-nav-close');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const desktopThemeToggle = document.getElementById('theme-toggle-desktop');
    const themeToggle = document.getElementById('theme-toggle-mobile');
    let observer: IntersectionObserver | null = null;

    function loadSectionNavigation(sectionId: string) {
      desktopHost!.replaceChildren();
      mobileHost!.replaceChildren();
      const template = document.querySelector<HTMLTemplateElement>(`template[data-section-navigation-template="${sectionId}"]`);
      if (!template) return;
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const desktop = fragment.querySelector('.section-nav-desktop');
      const mobile = fragment.querySelector('.section-nav-mobile');
      if (desktop) desktopHost?.append(desktop);
      if (mobile) mobileHost?.append(mobile);
    }

    function setContext(contextId: string) {
      const isOverview = contextId === 'overview';
      desktopOverview?.classList.toggle('hidden', !isOverview);
      mobileOverview?.classList.toggle('hidden', !isOverview);
      desktopReturn?.classList.toggle('hidden', isOverview);
      mobileReturnBox?.classList.toggle('hidden', isOverview);
      desktopHost?.classList.toggle('hidden', isOverview);
      mobileHost?.classList.toggle('hidden', isOverview);
      if (mobileTitle) mobileTitle.textContent = isOverview ? 'Navigation' : 'Section Nav';
      if (!isOverview) loadSectionNavigation(contextId);
      updateScrollspy(contextId);
    }

    function updateScrollspy(contextId: string) {
      observer?.disconnect();
      const selector = contextId === 'overview'
        ? '#desktop-overview-navigation .nav-link'
        : '#desktop-section-navigation-host .nav-link';
      const links = document.querySelectorAll<HTMLAnchorElement>(selector);
      const targets = Array.from(links)
        .map((link) => document.getElementById(link.dataset.section || ''))
        .filter((element): element is HTMLElement => Boolean(element));
      if (!targets.length) return;
      const setActive = (id: string) => {
        document.querySelectorAll<HTMLAnchorElement>(
          `${selector}, ${contextId === 'overview' ? '#mobile-overview-navigation' : '#mobile-section-navigation-host'} .mobile-nav-link`
        ).forEach((link) => {
          const active = link.dataset.section === id;
          link.classList.toggle('bg-emerald-50', active);
          link.classList.toggle('dark:bg-emerald-950/40', active);
          link.classList.toggle('text-emerald-700', active);
          link.classList.toggle('dark:text-emerald-400', active);
          link.querySelector('.active-indicator')?.classList.toggle('opacity-100', active);
        });
      };
      observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && setActive(entry.target.id)), { rootMargin: '-20% 0px -60% 0px' });
      targets.forEach((target) => observer?.observe(target));
    }

    function closeMenu() {
      drawer?.classList.add('translate-x-full');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    toggle?.addEventListener('click', () => {
      drawer?.classList.toggle('translate-x-full');
      backdrop?.classList.toggle('opacity-0');
      backdrop?.classList.toggle('pointer-events-none');
      hamburger?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });
    close?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);
    document.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('.mobile-nav-link')) closeMenu();
    });
    desktopReturn?.addEventListener('click', () => document.getElementById('window-close-btn')?.click());
    mobileReturn?.addEventListener('click', () => document.getElementById('window-close-btn')?.click());
    function toggleTheme() {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    }

    desktopThemeToggle?.addEventListener('click', toggleTheme);
    themeToggle?.addEventListener('click', toggleTheme);
    window.addEventListener('sectionContextChange', (event) => {
      setContext((event as CustomEvent<{ sectionId?: string }>).detail?.sectionId || 'overview');
    });
    setContext('overview');
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupNavigation);
  else setupNavigation();
</script>
