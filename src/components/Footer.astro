---
import projectData from '../data/project.json';
---

<footer
  class="w-full mt-auto border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/60 py-12 transition-colors duration-300"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Project & Course Info -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-sm font-bold text-slate-900 dark:text-white">
            {projectData.name}
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          {projectData.metadata.course} · {projectData.metadata.institution} ({projectData.metadata.academicYear})
        </p>
      </div>

      <!-- Links & Back to Top -->
      <div class="flex items-center gap-6 text-xs text-slate-500 dark:text-slate-400">
        {
          projectData.footer?.githubRepo && (
            <a
              href={projectData.footer.githubRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
            </a>
          )
        }

        <a
          href="#hero"
          class="hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
        >
          Back to Top ↑
        </a>
      </div>
    </div>

    <!-- Copyright & License -->
    <div
      class="mt-8 pt-6 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs text-slate-400 dark:text-slate-500"
    >
      <p>
        &copy; {projectData.footer?.copyrightYear || '2026'} {projectData.name}. Released under {projectData.footer?.license || 'CC BY-NC 4.0'}.
      </p>
      <p>
        Designed with Astro &amp; Tailwind CSS for GitHub Pages
      </p>
    </div>
  </div>
</footer>
