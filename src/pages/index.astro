---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SectionSelector from '../components/SectionSelector.astro';
import SectionWindow from '../components/SectionWindow.astro';
---

<MainLayout>
  <!-- Level 1: Hero & Project Introduction -->
  <Hero />

  <!-- Visual divider between the overview and section selector -->
  <div class="w-full px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <div class="h-px w-full max-w-5xl mx-auto bg-slate-200 dark:bg-slate-800"></div>
  </div>

  <!-- Level 1: Horizontal Project Section Selector -->
  <SectionSelector />

  <!-- Level 2: Integrated Section Content Window (Opens directly beneath the selector) -->
  <SectionWindow />
</MainLayout>
